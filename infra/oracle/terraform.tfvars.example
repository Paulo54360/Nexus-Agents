# Copie ce fichier en terraform.tfvars (ne jamais commiter !)
tenancy_ocid         = "ocid1.tenancy.oc1..REMPLACE"
compartment_ocid     = "ocid1.compartment.oc1..REMPLACE"
user_ocid            = "ocid1.user.oc1..REMPLACE"
fingerprint          = "aa:bb:cc:dd:..."
oci_private_key_path = "~/.oci/oci_api_key.pem"
region               = "eu-paris-1"
ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
tailscale_authkey    = "tskey-auth-OPTIONNEL"
