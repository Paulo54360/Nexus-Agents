# ==============================================================================
# Nexus Agents — Environment Configuration
# Copy this file to .env and fill in your keys (never commit .env!)
# ==============================================================================

# --- Runtime ---
NEXUS_ENV=development
LOG_LEVEL=INFO
# Set to false once your MCP servers (Gmail, Google Calendar, Notion) are configured
MOCK_TOOLS=true

# --- LiteLLM Proxy (Hybrid LLM Router) ---
LITELLM_MASTER_KEY=sk-nexus-local-dev-key
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_FAST_MODEL=nexus-fast
LITELLM_SMART_MODEL=nexus-smart

# --- LLM Providers (fill at least one free-tier provider to start) ---
# Groq (Free tier - fast Llama 3.3 / Qwen): https://console.groq.com
GROQ_API_KEY=
# Google Gemini API (Free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GitHub Models (included with GitHub / GitHub Student): https://github.com/marketplace/models
GITHUB_TOKEN=
# Mistral AI (Free tier): https://console.mistral.ai
MISTRAL_API_KEY=
# Optional: Ollama running on your Mac over Tailscale (e.g. http://100.x.y.z:11434)
OLLAMA_API_BASE=

# --- PostgreSQL (LangGraph Checkpoints & Memory) ---
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=nexus
DATABASE_URL=postgresql://nexus:change-me-in-prod@postgres:5432/nexus

# --- Discord Bot (Private Server Interface) ---
DISCORD_BOT_TOKEN=
# Restrict bot responses to your own Discord user ID (recommended security guard!)
DISCORD_ALLOWED_USER_ID=
# Channel IDs in your private Discord server
DISCORD_COMMAND_CENTER_CHANNEL_ID=
DISCORD_BRIEFING_CHANNEL_ID=
DISCORD_GMAIL_TRIAGE_CHANNEL_ID=
DISCORD_REMINDERS_CHANNEL_ID=
DISCORD_ASSO_DIGEST_CHANNEL_ID=
# Association Discord Server (read-only monitoring)
DISCORD_ASSO_GUILD_ID=
# Optional comma-separated channel IDs to watch (empty = all readable channels)
DISCORD_ASSO_WATCH_CHANNEL_IDS=

# --- Proactive Scheduler (Timezone & CRON) ---
TIMEZONE=Europe/Paris
BRIEFING_HOUR=8
BRIEFING_MINUTE=0
ASSO_DIGEST_HOUR=20
ASSO_DIGEST_MINUTE=0
GMAIL_TRIAGE_INTERVAL_MINUTES=60

# --- MCP Servers Credentials (used when MOCK_TOOLS=false) ---
NOTION_API_KEY=
GOOGLE_OAUTH_CREDENTIALS_PATH=/app/secrets/google_credentials.json
GOOGLE_OAUTH_TOKEN_PATH=/app/secrets/google_token.json

# --- Observability: Langfuse (Optional — docker compose --profile observability up -d) ---
LANGFUSE_NEXTAUTH_SECRET=change-me-langfuse-nextauth-secret
LANGFUSE_SALT=change-me-langfuse-salt
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
